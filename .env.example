# Maya_OS + Job Hunt OS configuration. Copy to .env, fill in what you have.
# No env files were used before this; this is now the one place secrets live.
# Never commit the real .env. A missing key is a normal state everywhere in
# this app -- the thing that key enables reports itself unavailable, it does
# not fail silently and it does not fake a result.

# --- Remote access door -----------------------------------------------------
# Gates /ui, /jobs, and every /v1/* endpoint for anyone NOT on this machine
# (localhost is always allowed, never gated by this). Both values are
# required -- if either is blank, remote access is closed entirely, not
# opened by a default. Set a real password here, not the example below.
MAYA_LOGIN_USER=
MAYA_LOGIN_PASSWORD=

# --- LLM lanes (lanes.py) ---------------------------------------------------
# Free tier only, by design (see lanes.py FREE_TIER_ONLY). Any single one of
# these is enough to bring judgment/thinking/doc-creation work online. None
# are required for retrieval, recall, or the deterministic Job Hunt endpoints
# (tracker, daily control, dedupe) -- those run with zero keys configured.

GROQ_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=

CEREBRAS_BASE_URL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

MISTRAL_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

HOMEMATH_LANE_ORDER=groq,cerebras,openrouter,mistral

# --- Job Hunt Discovery (jobhunt_search.py) --------------------------------
# Headless Chrome (Playwright) is the primary and only REQUIRED search
# mechanism. It needs no key here -- it needs `pip install playwright` and
# `playwright install chromium` run once on the machine that runs Discovery
# (the host, never the Mac this was built on).
#
# TAVILY_API_KEY is fully optional and NOT a dependency of core Discovery.
# Leave it blank. If you ever add one, confirm first that Tavily's tier you
# are on stays free permanently, not just at signup -- the architecture
# assumes it may vanish at any time and degrades to the headless-browser path
# without it, honestly, every time.
TAVILY_API_KEY=

# Optional: restrict Discovery to specific ATS boards you already know about,
# comma-separated "company_name:greenhouse_token" pairs. Entirely optional --
# Discovery works without this, it just means fewer companies get the
# zero-risk ATS-feed enrichment path (jobhunt_search.fetch_greenhouse_postings
# etc.) until it discovers them itself.
# JOBHUNT_KNOWN_GREENHOUSE_BOARDS=
# JOBHUNT_KNOWN_LEVER_BOARDS=
# JOBHUNT_KNOWN_ASHBY_BOARDS=
